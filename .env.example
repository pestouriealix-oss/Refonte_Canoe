# Copie ce fichier en `.env` et renseigne tes propres valeurs.
# Le fichier `.env` est ignoré par Git : ne le publie jamais.

# --- Supabase (valeurs publiques, visibles dans le navigateur) ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Supabase (SECRET, serveur uniquement : contourne les règles d'accès) ---
SUPABASE_SERVICE_ROLE_KEY=""

# --- Paiement en ligne (facultatif : sans ces clés, seul le paiement sur place fonctionne) ---
# Clé publique Stripe, visible dans le navigateur
VITE_PAYMENTS_CLIENT_TOKEN=""
# Clés SECRÈTES, serveur uniquement
STRIPE_SANDBOX_API_KEY=""
STRIPE_LIVE_API_KEY=""
LOVABLE_API_KEY=""
